pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                sh 'mvn -B clean compile'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn -B test'
            }

            post {
                always {
                    junit(
                        testResults: 'target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Quality') {
            steps {
                sh 'mvn -B verify -DskipTests'
            }
        }

        stage('Package') {
            steps {
                archiveArtifacts(
                    artifacts: 'target/*.jar',
                    fingerprint: true
                )
            }
        }
    }

    post {
        success {
            echo 'Build, tests and quality checks completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the first failed stage.'
        }
    }
}